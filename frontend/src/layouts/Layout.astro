---
import '../styles/theme.css';
import '../styles/global.css';
import Navbar from '../components/Navbar.svelte';
import ArchiveSuggestModal from '../components/ArchiveSuggestModal.svelte';
import CaptureFab from '../components/CaptureFab.svelte';
import { href } from '../lib/paths';

interface Props {
  title: string;
  noNav?: boolean;
  /** The page renders its own inline CaptureBox, so no floating FAB. */
  hasCapture?: boolean;
}

const { title, noNav, hasCapture } = Astro.props;
const currentPath = Astro.url.pathname;
// Base-aware asset/SW URLs (host under a sub-path).
const iconUrl = href('/icon.svg');
const manifestUrl = href('/manifest.webmanifest');
const swUrl = href('/sw.js');
const swScope = href('/');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="description" content="Readerr — reading list and notes" />
    <meta name="theme-color" content="#2e7d43" />
    <link rel="icon" href={iconUrl} type="image/svg+xml" />
    <link rel="manifest" href={manifestUrl} />
    <title>{title} · Readerr</title>
    <script is:inline>
      // Apply the manual theme override before first paint to avoid a flash.
      // 'light'/'dark' pin the scheme; anything else follows the OS setting.
      try {
        const theme = localStorage.getItem('readerr-theme');
        if (theme === 'light' || theme === 'dark') {
          document.documentElement.style.colorScheme = theme;
        }
        // Custom theme CSS, pre-compiled by lib/theme.ts on save so this
        // boot path needs no imports and never flashes the default theme.
        const themeCss = localStorage.getItem('readerr-theme-css');
        if (themeCss) {
          const style = document.createElement('style');
          style.id = 'readerr-theme';
          style.textContent = themeCss;
          document.head.appendChild(style);
        }
      } catch {}
    </script>
  </head>
  <body>
    {!noNav && <Navbar client:load {currentPath} />}
    <script>
      // First-launch gate: send brand-new installs to onboarding. Existing
      // data (any links) counts as onboarded — those users are grandfathered
      // in silently rather than interrupted. Runs on every page (MPA).
      import { all } from '../lib/db/repo';
      import { getUserSettings, saveUserSettings } from '../lib/services/settings';
      import type { Link } from '../lib/db/types';
      import { href, isPath } from '../lib/paths';

      if (!isPath(location.pathname, '/onboarding/')) {
        try {
          // getUserSettings reconciles duplicate settings rows into the singleton.
          const settings = await getUserSettings();
          if (!settings?.onboarding_completed_at) {
            const links = await all<Link>('links');
            if (links.length > 0) {
              await saveUserSettings({ onboarding_completed_at: new Date().toISOString() });
            } else {
              location.replace(href('/onboarding/'));
            }
          }
        } catch (err) {
          console.error('[readerr] onboarding check failed:', err);
        }
      }
    </script>
    {!noNav && <ArchiveSuggestModal client:load />}
    {!noNav && !hasCapture && <CaptureFab client:only="svelte" />}
    <main class="page">
      <slot />
    </main>
    {
      import.meta.env.PROD ? (
        <script is:inline define:vars={{ swUrl, swScope }}>
          if ('serviceWorker' in navigator) {
            window.addEventListener('load', () => {
              navigator.serviceWorker.register(swUrl, { scope: swScope }).catch(() => {});
            });
          }
        </script>
      ) : (
        <script is:inline>
          // Dev: the service worker must NOT run — it caches Vite's module
          // URLs and serves stale code after edits (blank pages). Unregister
          // any leftover registration and drop its caches.
          if ('serviceWorker' in navigator) {
            navigator.serviceWorker.getRegistrations().then((regs) => {
              for (const reg of regs) reg.unregister();
            });
            if (window.caches) {
              caches.keys().then((keys) => keys.forEach((k) => caches.delete(k)));
            }
          }
        </script>
      )
    }
  </body>
</html>
